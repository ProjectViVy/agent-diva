{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Diva",
  "version": "0.1.0",
  "identifier": "org.projectvivy.agentdiva",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Diva",
        "width": 1100,
        "height": 760,
        "decorations": false,
        "transparent": true,
        "minWidth": 500,
        "minHeight": 400,
        "windowEffects": {
          "effects": [
            "acrylic",
            "underWindowBackground"
          ]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
